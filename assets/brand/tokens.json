  },

  "charts": {
    "sequential30": [
      "#EAFBFF", "#DBF9FE", "#CCF6FD", "#BDF4FC", "#AEF1FB",
      "#9FEFF9", "#90ECF8", "#81EAF7", "#71E4F3", "#60DDEF",
      "#50D6EA", "#3FCFE5", "#2FC8E0", "#1FC1DB", "#0EBAD6",
      "#08B0D6", "#0CA5D9", "#1199DC", "#158EDF", "#1982E2",
      "#1E77E5", "#226CE9", "#2562E9", "#245DE1", "#2358D8",
      "#2253D0", "#214EC8", "#204AC0", "#1F45B7", "#1E40AF"
    ],
    "discrete7": ["#1E40AF", "#1D4ED8", "#2563EB", "#06B6D4", "#22D3EE", "#67E8F9", "#A5F3FC"],
    "discreteNames": ["navy", "deep", "blue", "teal", "mint", "pale", "ice"],
    "categorical": {
      "sexo": { "Hombre": "#2563EB", "Mujer": "#06B6D4" }
    },
    "heights": {
      "paired": 480,
      "pyramid": 480,
      "single": 380,
      "small": 320
    }
  },

  "typography": {
    "heading": {
      "family": "Space Grotesk",
      "fallback": "Aeonik, Inter, system-ui, sans-serif",
      "weights": [500, 600, 700],
      "note": "Space Grotesk es el puente gratuito hacia Aeonik Bold (comercial, Lineto). Al comprar la licencia solo se cambia la fuente, no la escala."
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, -apple-system, sans-serif",
      "weights": [400, 500]
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "ui-monospace, monospace",
      "use": "Numeros de KPIs, tablas de datos, codigo, timestamps. Siempre con tabular-nums."
    },
    "fluidScale": {
      "topbar": "clamp(1.25rem, 0.9rem + 1.5vw, 1.5rem)",
      "section": "clamp(1.08rem, 0.9rem + 0.8vw, 1.32rem)",
      "kpi": "clamp(1.55rem, 1rem + 2.4vw, 2.15rem)",
      "kpiSm": "clamp(1.15rem, 0.95rem + 0.9vw, 1.45rem)"
    }
  },

  "layout": {
    "sidebar": {
      "width": "15.5rem",
      "gap": "1rem",
      "contentLeft": "16.5rem",
      "style": "Flotante (position fixed, separada del borde por gap), esquinas redondeadas 1rem."
    },
    "radius": {
      "panel": "12px",
      "sidebar": "1rem",
      "control": "0.55rem"
    },
    "touchTarget": "44px",
    "breakpoints": {
      "mobile": "1200px",
      "note": "Bajo 1200px: sidebar desaparece y aparece tab bar fija inferior."
    },
    "panelShadow": {
      "dark": "0 10px 24px rgba(0,0,0,0.20), inset 0 0 0 1px rgba(255,255,255,0.04)",
      "light": "0 2px 8px rgba(15,23,42,0.06)"
    }
  },

  "assets": {
    "logoPrincipal": "assets/logo-principal.svg",
    "logoBlanco": "assets/logo-blanco.svg",
    "logoNegativo": "assets/logo-negativo.svg",
    "favicon": "assets/favicon.ico",
    "rules": {
      "sobreFondoOscuro": "logo-blanco.svg o logo-negativo.svg",
      "sobreFondoClaro": "logo-principal.svg",
      "kitCompleto": "../kit_logo_marca/ (avatares, portadas, impresion, favicons en todos los tamanos)"
    }
  }
}
