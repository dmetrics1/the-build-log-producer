      "navy": "#1E40AF",
      "primary": "#2563EB",
      "cyan": "#06B6D4",
      "emerald": "#10B981"
    },
    "themes": {
      "dark": {
        "accent": "#2563EB",
        "accent2": "#06B6D4",
        "accent3": "#F59E0B",
