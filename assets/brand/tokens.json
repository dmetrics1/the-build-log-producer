{
  "meta": {
    "name": "dm-design-system",
    "version": "0.1.0",
    "owner": "Daniel Molina Barrios",
    "description": "Fuente única de verdad de la identidad visual DM para dashboards y productos de datos. Valores extraídos de personal_landing (colores_paleta.md / DESIGN_SYSTEM.md) y dashboard_mercado_laboral_co (app/main.py).",
    "canonical_sources": [
      "portafolio/personal_landing/colores_paleta.md",
      "portafolio/personal_landing/docs/DESIGN_SYSTEM.md",
      "portafolio/dashboard_mercado_laboral_co/app/main.py"
    ],
    "note": "El README de kit_logo_marca menciona un violeta #7C3AED como inicio del degradado: es la version anterior del kit. La paleta canonica vigente es la de la landing (azul #1E40AF como inicio)."
  },

  "brand": {
    "gradient": {
      "angle": "135deg",
      "stops": [
        { "color": "#1E40AF", "position": "0%" },
        { "color": "#2563EB", "position": "50%" },
        { "color": "#06B6D4", "position": "100%" }
      ],
      "css": "linear-gradient(135deg, #1E40AF 0%, #2563EB 50%, #06B6D4 100%)"
    },
    "tagline": "Transformo datos en soluciones, productos y decisiones.",
    "author": {
      "name": "Daniel Molina Barrios",
      "github": "https://github.com/dmetrics1",
      "linkedin": "https://www.linkedin.com/in/danieljmolina"
    }
  },

  "color": {
