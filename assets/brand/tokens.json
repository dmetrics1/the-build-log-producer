        "negative": "#E11D48",
        "bgBody": "#F3F6FB",
        "surface1": "#FFFFFF",
        "surface1Alt": "#F8FAFC",
        "surface2": "#FFFFFF",
        "surface3": "#F8FAFC",
        "cardBg": "#FFFFFF",
        "cardBgHover": "rgba(37,99,235,0.05)",
        "cardBorder": "rgba(15,23,42,0.10)",
        "textTitle": "#0B1220",
        "textBody": "#1E293B",
        "textMuted": "#64748B",
        "line": "rgba(15,23,42,0.10)",
        "kpi": "#1D4ED8",
        "eyebrowBg": "rgba(37,99,235,0.08)",
        "eyebrowText": "#1E40AF",
        "inputBg": "rgba(37,99,235,0.05)",
        "chartGrid": "rgba(15,23,42,0.08)",
